---
interface Props {
    title: string;
    description?: string;
}

const {title, description} = Astro.props;
const home = import.meta.env.BASE_URL;

// Rooted, no trailing slash, so `${base}/cms/edit.js` is right for a site
// at the root as well as for this one. `BASE_URL` carries the trailing
// slash and `index.astro` trims it the same way.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {/*
      The CMS, on the site's own pages.

      ONE tag, on EVERY page, and that is the shape of the thing rather
      than laziness: `edit.js` is the decision and nothing else -- about
      1.4 kB -- and everything behind the decision is a dynamic import. A
      reader downloads this file, asks sessionStorage two questions, and
      downloads nothing more. Restricting it to `blog/[...slug].astro`
      would save them nothing and would break the one behaviour that makes
      it feel like part of the site: a signed-in author keeps the editor as
      they move from page to page.

      `cms:config` is not optional here. The script defaults to
      `/cms-config.yml`, which is correct for a site at the root and a 404
      on this one -- Pages serves us under the repository name, so the file
      is at `/ContentTools-test/cms-config.yml`.
    */}
    <meta name="cms:config" content={`${base}/cms-config.yml`} />
    <script type="module" src={`${base}/cms/edit.js`}></script>
    <style is:global>
        :root { color-scheme: light dark; --ink: #1c1c1c; --paper: #fbfaf7; --muted: #6b6b6b; --rule: #e3e0d8; }
        @media (prefers-color-scheme: dark) {
            :root { --ink: #ece9e3; --paper: #16181c; --muted: #9a9a9a; --rule: #2c2f36; }
        }
        * { box-sizing: border-box; }
        body {
            margin: 0; background: var(--paper); color: var(--ink);
            font: 17px/1.65 ui-serif, Georgia, "Times New Roman", serif;
        }
        .wrap { max-width: 42rem; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
        header.site { border-bottom: 1px solid var(--rule); margin-bottom: 2.5rem; padding-bottom: 1rem; }
        header.site a { font: 600 15px/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .02em; text-decoration: none; color: var(--ink); }
        h1 { font-size: 2rem; line-height: 1.2; margin: 0 0 .35rem; }
        h2 { font-size: 1.3rem; margin: 2.25rem 0 .5rem; }
        h3 { font-size: 1.1rem; margin: 1.75rem 0 .5rem; }
        .meta { color: var(--muted); font: 14px/1.4 ui-sans-serif, system-ui, sans-serif; margin: 0 0 2rem; }
        blockquote { margin: 1.5rem 0; padding: .1rem 0 .1rem 1.1rem; border-left: 3px solid var(--rule); color: var(--muted); font-style: italic; }
        pre { background: color-mix(in srgb, var(--ink) 6%, transparent); padding: .9rem 1rem; overflow-x: auto; border-radius: 6px; font-size: 14px; }
        code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
        pre code { font-size: inherit; }
        img { max-width: 100%; height: auto; }
        a { color: inherit; }
        footer.site { border-top: 1px solid var(--rule); margin-top: 3rem; padding-top: 1rem; color: var(--muted); font: 14px/1.5 ui-sans-serif, system-ui, sans-serif; }
    </style>
</head>
<body>
    <div class="wrap">
        <header class="site"><a href={home}>ContentTools test site</a></header>
        <main><slot /></main>
        <footer class="site">
            Placeholder content. Edited by pull request with
            <a href="https://github.com/jamesjnadeau/ContentTools">ContentTools 2</a>.
        </footer>
    </div>
</body>
</html>
